{
  "Wrapper": {
    "BindUrl": "http://127.0.0.1:39749",
    "MaxRequestBodyBytes": 4194304,
    "QueueCapacity": 128,
    "Sessions": {
      "IdleTimeout": "00:20:00",
      "MaxIdleSessionCount": 128
    },
    "Child": {
      "Command": "",
      "Arguments": [],
      "WorkingDirectory": null,
      "IdleStopAfter": "00:20:00",
      "ShutdownGracePeriod": "00:00:02",
      "UseProcessGroupOnLinux": true
    },
    "Timeouts": {
      "Read": "00:00:10",
      "Write": "00:01:00",
      "Index": "00:05:00"
    },
    "Retry": {
      "MaxRetries": 2,
      "ReadOnlyRetryTools": [
        "initialize",
        "tools/list",
        "prompts/list",
        "prompts/get",
        "search_graph",
        "get_code_snippet",
        "get_file_outline",
        "compare_graphs",
        "get_architecture",
        "trace_path",
        "index_status",
        "list_projects",
        "get_graph_schema",
        "search_code",
        "check_index_coverage",
        "query_graph"
      ],
      "StableRunResetAfter": "00:00:30",
      "CrashLoopWindow": "00:01:00",
      "CrashLoopThreshold": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
